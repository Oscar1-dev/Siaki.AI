{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saiki.local/contracts/rig-manifest.v1.schema.json",
  "title": "SAIKI layered rig manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rigId", "displayName", "runtime", "logicalSize", "layers", "motions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rigId": { "$ref": "#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1 },
    "runtime": { "$ref": "#/$defs/id" },
    "logicalSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "asset", "zIndex", "anchor", "required"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["body", "face", "hair", "clothing", "accessory", "effect"] },
          "asset": { "type": "string", "minLength": 1, "maxLength": 260 },
          "zIndex": { "type": "integer" },
          "anchor": {
            "type": "array",
            "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }],
            "items": false
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "motions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "durationMs", "loop"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "durationMs": { "type": "number", "exclusiveMinimum": 0 },
          "loop": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
  }
}
